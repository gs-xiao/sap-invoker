# ============================================================
# 项目默认配置（进 git，人人 clone 下来就能跑）。
#
# 换一套 SAP 系统时：复制本文件为 .env.local，只留要改的行即可。
#   cp .env .env.local
#   .env.local 已被 .gitignore 忽略 —— 不会进 git，不影响别人。
#   Vite 先读 .env 再读 .env.local，同名 key 以 .env.local 为准，
#   所以 .env.local 里只写你要改的那几行就行，不用整份留着。
#
# 【重要】改完 env 必须重启 npm run dev —— env 和开发代理都只在启动时读一次。
# ============================================================

# ---- 1) 开发代理的目标 SAP 主机（node 端读，不能加 VITE_ 前缀）----
# 只在本地 npm run dev 时生效：浏览器请求 /sap-dev/xxx，由 Vite 转发到下面的地址，绕开 CORS。
# vite.config.js 直接扫描所有 SAP_*_TARGET 生成代理，变量名与前缀一一对应：
#   SAP_DEV_TARGET → /sap-dev、SAP_TEST_TARGET → /sap-test
# 新增一套环境 = 这里加一行 + src/config.js 的 ENVIRONMENTS 加一条，不用改 vite.config.js。
SAP_DEV_TARGET=http://172.18.1.10:8400
SAP_TEST_TARGET=http://172.18.1.10:8010

# ---- 2) ICF 服务名 + client（浏览器端读，必须带 VITE_ 前缀才能被前端代码取到）----
# 服务名 = SAP 事务码 SICF 里那个 HTTP 服务节点的名字（上面挂着分发器 handler 类），
# 也就是直连地址 http://<主机>:<端口>/<服务名> 里的最后一段。
VITE_SAP_DEV_SERVICE=zpub_api2
VITE_SAP_DEV_CLIENT=300
VITE_SAP_TEST_SERVICE=zpub_api
VITE_SAP_TEST_CLIENT=700

# 生产：打包部署到 BSP 后前端与 SAP 同源，不走代理、也不用带 sap-client（走 SAP 会话）。
VITE_SAP_PROD_SERVICE=zpub_api2

# ---- 3) 分发器 action 名与约定字段名 ----
# 每个 action 对应后端分发器里的一个 FM 分支（?action=<名字>）。
VITE_SAP_META_ACTION=Z_INVOKER_META
VITE_SAP_META_AI_ACTION=Z_INVOKER_META_AI
VITE_SAP_STORE_ACTION=Z_INVOKER_STORE

# 取元数据时，请求体里「目标函数名」用哪个 key 传给后端
VITE_SAP_META_FUNC_KEY=func_name

# 页面上「目标 FM 函数名」输入框的默认值
VITE_SAP_DEFAULT_FUNC=Z_SRM_CREATE_PO
